                      "transforms": [
                        {
                          "type": "script",
                          "code": "\timport themepack\n\topts = [{'value': '', 'label': 'its own base theme'}]\n\tstock, custom = [], []\n\tfor r in themepack.status():\n\t\tif r.get('kind') != 'custom':\n\t\t\tlabel = r['label']\n\t\t\tif not label.startswith('Ignition'):\n\t\t\t\tlabel = 'Ignition ' + label[0].lower() + label[1:]\n\t\t\tstock.append({'value': r['id'], 'label': label})\n\t\telif r.get('installed'):\n\t\t\tcustom.append({'value': r['id'], 'label': r['label']})\n\treturn opts + stock + custom"
                        }
                      ]
