{
  "custom": {
    "theme": "",
    "against": "",
    "key": "",
    "rows": [],
    "counts": {},
    "layers": []
  },
  "propConfig": {
    "custom.theme": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\tfor r in themepack.status():\n\t\tif r.get('kind') == 'custom' and r.get('installed'):\n\t\t\treturn r['id']\n\treturn ''"
          }
        ]
      }
    },
    "custom.key": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.theme} + '|' + {view.custom.against}"
        }
      }
    },
    "custom.rows": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.key"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\ttheme, against = (value + '|').split('|')[:2]\n\tif not theme:\n\t\treturn []\n\treturn themepack.compare(theme, against or None)"
          }
        ]
      }
    },
    "custom.counts": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.key"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\ttheme, against = (value + '|').split('|')[:2]\n\tif not theme:\n\t\treturn {}\n\treturn themepack.summary(theme, against or None)"
          }
        ]
      }
    },
    "custom.layers": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.theme"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\tif not value:\n\t\treturn []\n\treturn themepack.layers(value)"
          }
        ]
      }
    }
  },
