{
  "custom": {
    "tick": 0,
    "themes": []
  },
  "params": {},
  "props": {
    "defaultSize": {
      "width": 900,
      "height": 720
    }
  },
  "propConfig": {
    "custom.themes": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.tick"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\trows = themepack.status()\n\tSTOCK_STATE = {\n\t\t'stock': 'Stock - not modified',\n\t\t'updated': 'Updated (scrollbars + colour scheme)',\n\t\t'builtin': 'Inside the Perspective module - never touched',\n\t\t'missing': 'Not on this gateway',\n\t}\n\tfor row in rows:\n\t\trow['mode'] = 'Dark' if row['dark'] else 'Light'\n\t\trow['set'] = 'Custom' if row.get('kind') == 'custom' else 'Stock'\n\t\tif row.get('kind') == 'custom':\n\t\t\trow['state'] = 'Installed' if row['installed'] else 'Not installed'\n\t\telse:\n\t\t\trow['state'] = STOCK_STATE.get(row.get('stock'), '?')\n\treturn rows"
          }
        ]
      }
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {
      "grow": 0,
      "shrink": 0,
      "basis": "auto"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "overflow": "auto",
        "padding": "24px",
        "gap": "16px",
        "backgroundColor": "var(--containerRoot)"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "tabs"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "alignItems": "flex-end",
          "style": {
            "gap": "2px",
            "marginBottom": "6px",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "1px",
            "borderBottomColor": "var(--border)"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_home"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Installer",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "default",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "var(--callToAction)",
                "color": "var(--label)",
                "fontWeight": 600
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_themes"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "The themes",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--label--disabled)",
                "fontWeight": 400
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/themes')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_how"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "How it works",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--label--disabled)",
                "fontWeight": 400
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/how')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_changes"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Under the hood",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--label--disabled)",
                "fontWeight": 400
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/changes')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_contract"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "For builders",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--label--disabled)",
                "fontWeight": 400
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/contract')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "spacer"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "props": {}
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "theme_switcher"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "230px"
            },
            "props": {
              "path": "ThemeDropdown",
              "style": {
                "minHeight": "34px",
                "marginBottom": "4px"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "header"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "heading"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Theme Installer",
              "style": {
                "fontSize": "26px",
                "fontWeight": 600,
                "color": "var(--label)"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "subtitle"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Installs 10 curated Perspective gateway themes as config resources - the stock themes are never touched by this. Safe to re-run: installing overwrites the gateway's copies, which repairs the themes after an Ignition upgrade. Safe to delete this project afterwards. v1.7.2",
              "style": {
                "fontSize": "13px",
                "color": "var(--label--disabled)"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "subtitle_stock"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Optional: 'Update stock themes' adds ONLY themed scrollbars and a colour-scheme declaration to the four on-disk stock variants - their look does not change, and 'Restore stock themes' puts them back exactly. Light and Dark live inside the Perspective module, so they are never touched.",
              "style": {
                "fontSize": "13px",
                "color": "var(--label--disabled)"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "actions"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "install_all_btn"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Install custom themes"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport themepack\n\tthemepack.install_all()\n\tself.view.custom.tick += 1"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "remove_all_btn"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Remove custom themes",
              "style": {
                "backgroundColor": "var(--containerNested)",
                "color": "var(--label)"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport themepack\n\tthemepack.uninstall_all()\n\tself.view.custom.tick += 1"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "update_stock_btn"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Update stock themes",
              "style": {
                "backgroundColor": "var(--containerNested)",
                "color": "var(--label)"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport themepack\n\tthemepack.stock_update_all()\n\tself.view.custom.tick += 1"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "restore_stock_btn"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Restore stock themes",
              "style": {
                "backgroundColor": "var(--containerNested)",
                "color": "var(--label)"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport themepack\n\tthemepack.stock_restore_all()\n\tself.view.custom.tick += 1"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "theme_switcher_btn"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Theme switcher",
              "style": {
                "backgroundColor": "transparent",
                "border": "1px solid var(--border)",
                "color": "var(--label)"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\n\t\t'theme-installer-selector',\n\t\t'SelectorPopup',\n\t\ttitle='Theme switcher',\n\t\tmodal=True,\n\t\tdraggable=True,\n\t\tresizable=False,\n\t\toverlayDismiss=True,\n\t\tviewportBound=True,\n\t\tposition={'width': 560, 'height': 590})"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ],
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "12px"
          }
        }
      },
      {
        "type": "ia.display.table",
        "meta": {
          "name": "themes_table"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "data": [],
          "pager": {
            "top": false,
            "bottom": false
          },
          "columns": [
            {
              "field": "set",
              "header": {
                "title": "Set"
              },
              "width": 90,
              "strictWidth": true
            },
            {
              "field": "label",
              "header": {
                "title": "Theme"
              }
            },
            {
              "field": "mode",
              "header": {
                "title": "Mode"
              },
              "width": 100,
              "strictWidth": true
            },
            {
              "field": "state",
              "header": {
                "title": "Status"
              },
              "width": 320,
              "strictWidth": true
            }
          ]
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.themes"
              }
            }
          }
        }
      }
    ]
  }
}
