                    "script": "\timport themepack\n\ttry:\n\t\tthemepack.refresh()\n\t\tself.view.custom.status = 'Scanned -- the gateway has re-read the themes'\n\texcept Exception, e:\n\t\tself.view.custom.status = str(e)"
