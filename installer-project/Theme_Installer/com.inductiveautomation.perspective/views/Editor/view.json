              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\timport themepack\n\tfilename = self.view.custom.file\n\tif not filename:\n\t\tself.view.custom.status = 'Pick a file first'\n\t\treturn\n\ttry:\n\t\tthemepack.revert_file(self.view.custom.theme, filename)\n\t\tself.view.custom.status = ('Put back what the installer ships for %s'\n\t\t                           % filename)\n\t\tself.view.custom.nudge = self.view.custom.nudge + 1\n\texcept Exception, e:\n\t\tself.view.custom.status = str(e)"
                  },
