{
  "custom": {
    "theme": "",
    "file": "variables.css",
    "against": "",
    "key": "",
    "rows": [],
    "text": "",
    "status": "",
    "sel_name": "",
    "sel_value": "",
    "nudge": 0
  },
  "propConfig": {
    "custom.theme": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\tfor r in themepack.list_themes():\n\t\tif r['ours']:\n\t\t\treturn r['id']\n\trows = themepack.list_themes()\n\treturn rows[0]['id'] if rows else ''"
          }
        ]
      }
    },
    "custom.against": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.theme"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\tif not value:\n\t\treturn ''\n\treturn themepack.base_of(value)"
          }
        ]
      }
    },
    "custom.key": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.theme} + '|' + {view.custom.file} + '|' + {view.custom.against} + '|' + {view.custom.nudge}"
        }
      }
    },
    "custom.rows": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.key"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\ttheme, filename, against = (value + '||').split('|')[:3]\n\tif not theme or filename != 'variables.css':\n\t\treturn []\n\ttry:\n\t\treturn themepack.tokens_compared(theme, against or None)\n\texcept Exception, e:\n\t\treturn []"
          }
        ]
      }
    },
    "custom.text": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.key"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport themepack\n\ttheme, filename = (value + '|').split('|')[:2]\n\tif not theme or not filename:\n\t\treturn ''\n\ttry:\n\t\treturn themepack.read_file(theme, filename)['text']\n\texcept Exception, e:\n\t\treturn str(e)"
          }
        ]
      }
    }
  },
