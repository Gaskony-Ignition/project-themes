                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\timport themepack\n\tstock, custom = [], []\n\tfor r in themepack.status():\n\t\tif r.get('kind') != 'custom':\n\t\t\tif r.get('stock') == 'missing':\n\t\t\t\tcontinue\n\t\t\tstock.append({'value': r['id'],\n\t\t\t              'label': themepack.label_of(r['id'])})\n\t\telif r.get('installed'):\n\t\t\tcustom.append({'value': r['id'], 'label': r['label']})\n\treturn stock + custom"
                        }
                      ]
                    }
